# Authorization key from the GigaChat developer dashboard (base64 Client ID:Secret).
# Leave empty to run in explicitly labelled demo mode. Never use NEXT_PUBLIC_ for secrets.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Optional temporary bearer token instead of credentials (does not auto-renew).
# GIGACHAT_ACCESS_TOKEN=
# If the runtime does not trust the official CA, supply the official PEM bundle.
# GIGACHAT_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
